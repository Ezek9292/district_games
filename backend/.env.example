# Supabase → Project settings → Database → Connection string
# Pooled connection (port 6543) used by the running app:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session connection (port 5432) used by Prisma migrations:
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

PORT=4000
# Set to "production" on the server.
NODE_ENV=development
# Where the Next.js frontend runs (comma-separate several origins)
FRONTEND_ORIGIN="http://localhost:3000"

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=""

# Comma-separated emails that are organizers. `npm run db:seed` adds them.
ORGANIZER_EMAILS="you@example.com"

# SMTP for sending login codes (Resend, Brevo, Gmail app password, etc.).
# Leave SMTP_HOST empty in development to print codes to the console instead. Required in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Taifa District of SDA <no-reply@example.com>"

# Player photos: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""
